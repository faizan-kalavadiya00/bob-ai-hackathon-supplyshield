# Copy this file to src/backend/.env and fill in your actual values.
# NEVER commit the .env file — it is in .gitignore.

# ─── Database ─────────────────────────────────────────────────────────────────
# Async URL used by the FastAPI application (psycopg3 async driver).
DATABASE_URL=postgresql+psycopg_async://postgres:<YOUR_PASSWORD>@localhost:5432/supplyshield

# Sync URL used by Alembic migrations and the seed script (psycopg3 sync driver).
DATABASE_SYNC_URL=postgresql+psycopg://postgres:<YOUR_PASSWORD>@localhost:5432/supplyshield

# ─── Application ──────────────────────────────────────────────────────────────
APP_PORT=8000
APP_ENV=development
DEBUG=true

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for the FastAPI backend.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── IBM watsonx.ai (optional — app runs without these) ───────────────────────
WATSONX_API_KEY=your_api_key_here
WATSONX_PROJECT_ID=your_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# ─── Notifications (optional) ─────────────────────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url
